<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- A call keeps running with the app in the background or the screen off. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
  <!-- Sharing the screen in a call: react-native-webrtc's capture service (Android 14+). -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
  <!-- Choosing the speaker, earpiece or headset for the call. -->
  <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

  <application>
    <service
      android:name="io.zgaf.chatter.call.CallService"
      android:exported="false"
      android:foregroundServiceType="microphone" />
  </application>
</manifest>
