{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@chatter/core/*": ["../packages/core/src/*"],
      "@noble/*": ["./node_modules/@noble/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "src/uniwind-types.d.ts"],
  "exclude": ["node_modules", "../packages/core/src/**/__tests__"]
}
